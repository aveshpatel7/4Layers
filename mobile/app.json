{
  "expo": {
    "name": "GO SMART",
    "slug": "go-smart-mobile",
    "scheme": "gosmart",
    "version": "2.1.0",
    "icon": "./assets/4layers_logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/4layers_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/4layers_logo.png"
    },
    "android": {
      "package": "com.smartnest.app",
      "versionCode": 25,
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/4layers_logo.png",
        "backgroundColor": "#000000"
      },
      "usesCleartextTraffic": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "REQUEST_INSTALL_PACKAGES",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "Allow GO SMART to find and provision your smart switchboard."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "owner": "mohammad-777s",
    "extra": {
      "googleClientId": "972753923440-npkju4948rt72csvuivqnulavv98t9i6.apps.googleusercontent.com",
      "eas": {
        "projectId": "91b9d718-8b1e-4ae8-b691-d43f37c0ed32"
      }
    }
  }
}
