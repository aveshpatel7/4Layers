{
  "expo": {
    "name": "4Layers",
    "slug": "smartnest-mobile",
    "scheme": "4layers",
    "version": "2.0.3",
    "icon": "./assets/4layers_logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/4layers_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/4layers_logo.png"
    },
    "android": {
      "package": "com.smartnest.app",
      "versionCode": 9,
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/4layers_logo.png",
        "backgroundColor": "#000000"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "REQUEST_INSTALL_PACKAGES",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow 4Layers to access the camera to scan device QR codes."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow 4Layers to connect to your smart switchboard devices."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "owner": "mohammad-777s",
    "extra": {
      "googleClientId": "972753923440-npkju4948rt72csvuivqnulavv98t9i6.apps.googleusercontent.com",
      "eas": {
        "projectId": "91b9d718-8b1e-4ae8-b691-d43f37c0ed32"
      }
    }
  }
}
