{
  "expo": {
    "name": "GO SMART",
    "slug": "go-smart-mobile",
    "scheme": "gosmart",
    "version": "3.0.0",
    "icon": "./assets/4layers_logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/4layers_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/4layers_logo.png"
    },
    "android": {
      "package": "com.smartnest.app",
      "versionCode": 30,
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/4layers_logo.png",
        "backgroundColor": "#000000"
      },
      "usesCleartextTraffic": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Allow GO SMART to find and provision your smart switchboard."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
